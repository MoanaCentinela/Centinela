{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "target": "ES2022",

    "types": ["node"],

    "strict": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "sourceMap": true,

    "skipLibCheck": true
  },

  "include": ["src"],

  "exclude": [
    "dist",
    "node_modules"
  ]
}